#!/bin/sh
set -eu

staged_ts=$(git diff --cached --name-only --diff-filter=ACMRTUXB -- '*.ts')
if [ -n "$staged_ts" ]; then
  # Paths in this repository do not contain whitespace; avoid npx so this
  # hook cannot download or execute an unpinned package.
  npm exec --offline -- eslint --fix -- $staged_ts
  git add -- $staged_ts
fi

git diff --cached --check
gitleaks protect --staged --redact
