#!/bin/sh
set -eu

git fetch origin main --quiet
base_sha=$(git merge-base origin/main HEAD)

# Secret scanning in the pushed commit range is fast; CI performs the full
# history scan on the merge gate.
gitleaks detect --source . --log-opts="${base_sha}..HEAD" --redact

npm run typecheck

changed_files=$(git diff --name-only --diff-filter=ACMRTUXB "$base_sha" HEAD)
changed_ts=$(git diff --name-only --diff-filter=ACMRTUXB "$base_sha" HEAD -- '*.ts')
if [ -n "$changed_ts" ]; then
  npm exec --offline -- eslint $changed_ts
fi

full_test=false
needs_build=false
for changed_file in $changed_files; do
  case "$changed_file" in
    package.json|package-lock.json|.npmrc|tsconfig*.json|vitest.config.*|eslint.config.*|Dockerfile|.github/workflows/*|src/index.ts)
      full_test=true
      ;;
  esac
  case "$changed_file" in
    src/*|tsconfig*.json)
      needs_build=true
      ;;
  esac
done

if [ "$full_test" = true ]; then
  npm test
else
  npm exec --offline -- vitest run --changed "$base_sha"
fi

npm run test:thresholds:changed -- --base "$base_sha"

if [ "$needs_build" = true ]; then
  npm run build
fi
