# Supply-chain hardening.
# Never run install/postinstall/prepare scripts from a package automatically —
# the single most common vector for a compromised dependency to execute code
# on install. This also applies to our own "prepare" (husky) script; after
# `npm install`, run `npm run prepare` once yourself to install git hooks.
ignore-scripts=true

# Always pin exact versions (no ^ / ~ ranges) so a future `npm install` never
# silently pulls in a newer, unreviewed version of a dependency.
save-exact=true
