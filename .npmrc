# Supply-chain hardening.

# Resolve only from the public npm registry and require the lockfile format
# checked into this repository. `lockfile-version=3` keeps installs
# deterministic on the supported modern npm toolchain.
registry=https://registry.npmjs.org/
package-lock=true
lockfile-version=3

# Quarantine newly published packages for 3 days. npm 11+ enforces this
# during dependency resolution; CI pins npm 11 before running installs.
min-release-age=4320

# Reject dependency sources that bypass the registry and lockfile review.
allow-git=none
allow-remote=none
allow-file=none
allow-directory=none

# Never run dependency lifecycle scripts automatically. If a package truly
# needs one, invoke it explicitly after reviewing the package.
ignore-scripts=true

# Fail installs with incompatible engines, peer dependencies, or TLS.
engine-strict=true
strict-peer-deps=true
strict-ssl=true
audit=true

# Never write a floating dependency range when adding a package.
save-exact=true
