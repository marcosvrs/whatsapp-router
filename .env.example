# --- Required ---

# API key configured on your WAHA instance.
WAHA_API_KEY=changeme

# Shared secret used to verify WAHA's webhook HMAC signature (X-Webhook-Hmac).
# Configure the same value as the "key" in your WAHA session's webhook.hmac config.
WEBHOOK_SECRET=changeme

# --- WAHA connection ---
WAHA_BASE_URL=http://waha:3000
WAHA_SESSION=default

# --- Access control ---
# Comma-separated list of phone numbers (no "+", no leading zero after the
# country code — the same digits WAHA resolves a contact's chatId to) allowed
# to trigger the bot, in 1:1 chats or by @-mentioning it in any group.
WHATSAPP_ALLOWED_USERS=

# --- Home Assistant integration ("ha:" prefix) — optional ---
HASS_BASE_URL=http://homeassistant:8123
HASS_TOKEN=
HA_WEBHOOK_ID=

# --- Firefly III integration ("money:" prefix) — optional ---
FIII_BASE_URL=http://firefly:8080
FIII_PAT=
FIII_DEFAULT_SOURCE_ACCOUNT=

# --- opencode agent integration (default, no prefix) — optional ---
OPENCODE_BASE_URL=http://opencode:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
# Explicit model override, e.g. provider "openai" / model "gpt-5.6-luna".
# Leave both empty to use the opencode server's own default agent/model.
OPENCODE_MODEL_PROVIDER=
OPENCODE_MODEL_ID=
# The agent's name, as it should refer to itself — sent as part of the
# per-message system context (see README), not used for anything else.
AGENT_NAME=Jarvis

# --- Misc ---
PORT=8080
SESSIONS_FILE=/app/state/sessions.json
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=300000
